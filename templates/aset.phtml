<div class="modal fade" id="dapurDialog" tabindex="-1" aria-labelledby="dapurDialogJudul" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="dapurDialogForm" autocomplete="off">
            <div class="modal-header"><h2 class="modal-title h5" id="dapurDialogJudul"></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
            <div class="modal-body">
                <div id="dapurDialogPesan"></div>
                <input class="form-control mt-2 d-none" id="dapurDialogIsian" maxlength="255" aria-label="Isian">
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="dapurDialogBatal">Batal</button><button class="btn btn-success fw-semibold" id="dapurDialogYa"></button></div>
        </form>
    </div>
</div>
<script>
(() => {
    // Jendela dialog dashboard pengganti confirm()/prompt()/alert() browser, agar serasi dengan tema dan pesannya bisa
    // berformat. pesan berupa HTML yang sudah aman (nama dari server sudah di-escape; dari JavaScript lewat teksAman).
    const dialog = (() => {
        const el = document.getElementById('dapurDialog');
        const isian = document.getElementById('dapurDialogIsian');
        const ya = document.getElementById('dapurDialogYa');
        const batal = document.getElementById('dapurDialogBatal');
        let selesai = null;
        el.addEventListener('hidden.bs.modal', () => { if (selesai) { const s = selesai; selesai = null; s(null); } });
        document.getElementById('dapurDialogForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const s = selesai;
            selesai = null;
            bootstrap.Modal.getOrCreateInstance(el).hide();
            s?.(isian.classList.contains('d-none') ? true : isian.value);
        });
        el.addEventListener('shown.bs.modal', () => (isian.classList.contains('d-none') ? ya : isian).focus());
        return ({ judul = 'Konfirmasi', pesan = '', tombol = 'Ya', bahaya = false, nilai = null, tanpaBatal = false }) => new Promise((hasil) => {
            selesai = hasil;
            el.querySelector('.modal-title').textContent = judul;
            document.getElementById('dapurDialogPesan').innerHTML = pesan;
            isian.classList.toggle('d-none', nilai === null);
            isian.value = nilai ?? '';
            ya.textContent = tombol;
            ya.className = 'btn fw-semibold ' + (bahaya ? 'btn-danger' : 'btn-success');
            batal.classList.toggle('d-none', tanpaBatal);
            bootstrap.Modal.getOrCreateInstance(el).show();
            if (nilai !== null) {
                el.addEventListener('shown.bs.modal', () => {
                    const titik = isian.value.lastIndexOf('.');
                    isian.setSelectionRange(0, titik > 0 ? titik : isian.value.length);
                }, { once: true });
            }
        });
    })();
    const teksDialog = (s) => { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; };
    const pesanGalat = (teks) => dialog({ judul: 'Tidak Berhasil', pesan: teksDialog(teks), tombol: 'Tutup', tanpaBatal: true });

    // Tombol dalam form dengan data-konfirmasi: tanyakan dulu, baru kirim form.
    document.addEventListener('click', async (e) => {
        const tombol = e.target.closest('[data-konfirmasi]');
        if (!tombol) {
            return;
        }
        e.preventDefault();
        const form = tombol.closest('form');
        const ok = await dialog({
            judul: tombol.dataset.judul || 'Konfirmasi',
            pesan: tombol.dataset.konfirmasi,
            tombol: tombol.dataset.tombol || 'Ya',
            bahaya: tombol.dataset.bahaya === '1',
        });
        if (ok && form) {
            form.submit();
        }
    });

    // Ganti nama: tanyakan nama baru lalu kirim form.
    document.querySelectorAll('.aset-ganti-nama button').forEach((tombol) => {
        tombol.addEventListener('click', async (e) => {
            e.preventDefault();
            const baru = await dialog({ judul: 'Ganti Nama', pesan: 'Nama baru untuk <b>' + teksDialog(tombol.dataset.nama) + '</b>:', tombol: 'Simpan', nilai: tombol.dataset.nama });
            if (baru && baru !== tombol.dataset.nama) {
                const form = tombol.closest('form');
                form.querySelector('[name=nama_baru]').value = baru;
                form.submit();
            }
        });
    });

    // Unggah bertahap: setiap file dipotong (bawaan 1 MB) dan dikirim berurutan.
    const kotak = document.getElementById('asetTarik');
    if (!kotak) {
        return;
    }

    const d = kotak.dataset;
    const daftar = document.getElementById('asetDaftarUnggah');
    const bongkar = document.getElementById('asetBongkar');
    let berjalan = false;
    const antrean = [];

    const kirim = async (data) => {
        const form = new FormData();
        form.append(d.csrfNama, d.csrf);
        for (const [k, v] of Object.entries(data)) {
            form.append(k, v);
        }
        const jawab = await fetch(location.pathname, { method: 'POST', body: form, credentials: 'same-origin' });
        let isi = {};
        try { isi = await jawab.json(); } catch (_) { isi = { galat: 'Server menjawab ' + jawab.status + '.' }; }
        if (!jawab.ok || isi.galat) {
            throw new Error(isi.galat || ('Server menjawab ' + jawab.status + '.'));
        }
        return isi;
    };

    const unggahSatu = async (file, jalur) => {
        const baris = document.createElement('li');
        const teks = document.createElement('span');
        teks.textContent = jalur + ' ';
        const status = document.createElement('span');
        status.className = 'text-body-secondary';
        baris.append(teks, status);
        daftar.append(baris);

        if (file.size > Number(d.maks)) {
            status.className = 'text-danger';
            status.textContent = 'terlalu besar';
            return false;
        }

        let kode = '';
        try {
            kode = (await kirim({ aksi: 'unggah_mulai', nama: d.nama, versi: d.versi, folder: d.folder, file: jalur, ukuran: file.size, bongkar: bongkar && bongkar.checked ? '1' : '0' })).kode;
            const potongan = Number(d.potongan);
            for (let nomor = 0, awal = 0; awal < file.size || (nomor === 0 && file.size === 0); nomor++, awal += potongan) {
                if (file.size > 0) {
                    await kirim({ aksi: 'unggah_potongan', kode, nomor, potongan: file.slice(awal, awal + potongan) });
                    status.textContent = Math.min(100, Math.round((awal + potongan) / file.size * 100)) + '%';
                } else {
                    break;
                }
            }
            const hasil = await kirim({ aksi: 'unggah_selesai', kode });
            status.className = 'text-success';
            status.textContent = hasil.pesan || 'selesai';
            return true;
        } catch (e) {
            status.className = 'text-danger';
            status.textContent = e.message;
            if (kode) {
                kirim({ aksi: 'unggah_batal', kode }).catch(() => {});
            }
            return false;
        }
    };

    const jalankan = async () => {
        if (berjalan) {
            return;
        }
        berjalan = true;
        let berhasil = 0, gagal = 0;
        while (antrean.length) {
            const [file, jalur] = antrean.shift();
            if (await unggahSatu(file, jalur)) {
                berhasil++;
            } else {
                gagal++;
            }
        }
        berjalan = false;
        if (berhasil > 0 && gagal === 0) {
            // Semua berhasil: muat ulang daftar otomatis sebentar kemudian.
            const muat = document.createElement('li');
            muat.className = 'text-body-secondary';
            muat.textContent = 'Selesai. Memuat ulang daftar…';
            daftar.append(muat);
            setTimeout(() => location.reload(), 800);
        } else if (berhasil > 0) {
            // Ada yang gagal: daftar tidak dimuat ulang otomatis agar pesan galatnya tetap terbaca.
            const muat = document.createElement('li');
            muat.innerHTML = '<a href="#" class="fw-semibold">Muat ulang daftar file</a>';
            muat.querySelector('a').addEventListener('click', (e) => { e.preventDefault(); location.reload(); });
            daftar.append(muat);
        }
    };

    const tambah = (files) => {
        for (const file of files) {
            antrean.push([file, file.webkitRelativePath || file.name]);
        }
        jalankan();
    };

    document.getElementById('asetPilihFile').addEventListener('change', (e) => { tambah(e.target.files); e.target.value = ''; });
    document.getElementById('asetPilihFolder').addEventListener('change', (e) => { tambah(e.target.files); e.target.value = ''; });
    ['dragenter', 'dragover'].forEach((n) => kotak.addEventListener(n, (e) => { e.preventDefault(); kotak.classList.add('aset-tarik-aktif'); }));
    ['dragleave', 'drop'].forEach((n) => kotak.addEventListener(n, () => kotak.classList.remove('aset-tarik-aktif')));
    kotak.addEventListener('drop', (e) => { e.preventDefault(); tambah(e.dataTransfer.files); });
})();
</script>
