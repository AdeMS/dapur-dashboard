<?php
/**
 * Menu dashboard. Tidak menghasilkan keluaran di halaman: isinya dikirim ke navbar layout
 * lewat placeholder 'menu' (tautan) dan 'menu-kanan' (avatar inisial user dengan submenu nama, email, dan tombol keluar).
 *
 * @var array $menu
 * @var string|null $ruteAktif
 * @var AdeMS\Dapur\Dashboard\User|null $user
 * @var string $tokenCsrf
 * @var string $fieldCsrf
 */
?>
<style>
    /* Avatar inisial user di navbar, berbentuk bola hijau; nanti diganti foto profil bila ada */
    .dashboard-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 50%;
        /* Cahaya dari kiri atas: terang di pantulan, gelap di sisi bawah kanan */
        background: radial-gradient(circle at 32% 28%, #6fd39c 0%, #28a466 22%, #198754 50%, #0f5c39 80%, #093a24 100%);
        color: #fff;
        font-size: .9rem;
        font-weight: 600;
        letter-spacing: .02em;
        line-height: 1;
        text-shadow: 0 1px 2px rgba(0, 0, 0, .45);
        box-shadow: inset -2px -3px 5px rgba(0, 0, 0, .35), inset 2px 2px 4px rgba(255, 255, 255, .15), 0 2px 4px rgba(0, 0, 0, .4);
    }
</style>
<?php $this->placeholder('menu')->captureStart() ?>
<?php foreach ($this->menu as $item) : ?>
<?php $aktif = $item['rute'] === $this->ruteAktif ?>
                            <li class="nav-item">
                                <a class="nav-link<?= $aktif ? ' active' : '' ?>" href="<?= $this->escapeHtmlAttr($this->url($item['rute'])) ?>"<?= $aktif ? ' aria-current="page"' : '' ?>>
                                    <i class="bi bi-<?= $this->escapeHtmlAttr($item['ikon']) ?> me-1"></i><?= $this->escapeHtml($item['label']) ?>
                                </a>
                            </li>
<?php endforeach ?>
<?php $this->placeholder('menu')->captureEnd() ?>
<?php $this->placeholder('menu-kanan')->captureStart() ?>
                            <li class="nav-item dropdown">
                                <button class="btn btn-link nav-link dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu user <?= $this->escapeHtmlAttr($this->user->nama) ?>">
                                    <span class="dashboard-avatar" aria-hidden="true"><?= $this->escapeHtml($this->user->inisial()) ?></span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="dropdown-item-text">
                                        <div class="fw-semibold"><?= $this->escapeHtml($this->user->nama) ?></div>
                                        <div class="small text-body-secondary"><?= $this->escapeHtml($this->user->email) ?></div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="<?= $this->escapeHtmlAttr($this->url('dashboard.keluar')) ?>">
                                            <input type="hidden" name="<?= $this->escapeHtmlAttr($this->fieldCsrf) ?>" value="<?= $this->escapeHtmlAttr($this->tokenCsrf) ?>">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Keluar</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
<?php $this->placeholder('menu-kanan')->captureEnd() ?>
