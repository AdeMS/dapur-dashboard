<?php
/**
 * Menu dashboard. Tidak menghasilkan keluaran di halaman: tautan dikirim ke placeholder 'menu' pada navbar
 * layout, dan menu user (avatar dengan submenu) dari paket adems/dapur-user ke placeholder 'menu-kanan'.
 *
 * @var array $menu
 * @var string|null $ruteAktif
 * @var AdeMS\Dapur\User\User|null $user
 * @var string $alamatKeluar
 * @var string $tokenCsrf
 * @var string $fieldCsrf
 */
?>
<?php $this->placeholder('menu')->captureStart() ?>
<?php foreach ($this->menu as $item) : ?>
<?php $aktif = $item['rute'] === $this->ruteAktif ?>
                            <li class="nav-item">
                                <a class="nav-link<?= $aktif ? ' active' : '' ?>" href="<?= $this->escapeHtmlAttr($this->url($item['rute'])) ?>"<?= $aktif ? ' aria-current="page"' : '' ?>>
                                    <i class="bi bi-<?= $this->escapeHtmlAttr($item['ikon']) ?> me-1"></i><?= $this->escapeHtml($item['label']) ?>
                                </a>
                            </li>
<?php endforeach ?>
<?php $this->placeholder('menu')->captureEnd() ?>
<?php if ($this->user) : ?>
<?= $this->partial('user::menu-user', [
    'user'         => $this->user,
    'alamatKeluar' => $this->alamatKeluar,
    'tokenCsrf'    => $this->tokenCsrf,
    'fieldCsrf'    => $this->fieldCsrf,
]) ?>
<?php endif ?>
