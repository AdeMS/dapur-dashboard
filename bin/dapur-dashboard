#!/usr/bin/env php
<?php

/**
 * Perintah modul dashboard Dapur AdeMS. Jalankan dari folder inti:
 *
 *   vendor/bin/dapur-dashboard pasang
 *   vendor/bin/dapur-dashboard buat-admin <email> [--nama="Nama Lengkap"]
 *   vendor/bin/dapur-dashboard ganti-sandi <email>
 */

declare(strict_types=1);

use AdeMS\Dapur\Dashboard\DaftarUser;
use AdeMS\Dapur\Dashboard\Konteks;
use AdeMS\Dapur\Dashboard\Perintah;
use Laminas\Db\Adapter\Adapter;

require $GLOBALS['_composer_autoload_path'] ?? dirname(__DIR__, 3) . '/autoload.php';

$bacaSandi = static function (string $pesan): string {
    $tersembunyi = stream_isatty(STDIN);

    echo $pesan;
    if ($tersembunyi) {
        shell_exec('stty -echo');
    }

    $baris = fgets(STDIN);

    if ($tersembunyi) {
        shell_exec('stty echo');
        echo PHP_EOL;
    }

    return rtrim((string) $baris, "\r\n");
};

// Pertanyaan ya/tidak hanya diajukan bila dijalankan di terminal; dari skrip tidak ada yang ditanyakan.
$tanya = stream_isatty(STDIN)
    ? static function (string $pesan): string {
        echo $pesan;

        return rtrim((string) fgets(STDIN), "\r\n");
    }
    : null;

$argumen = array_values(array_slice($argv, 1));

try {
    chdir(Konteks::folderInti());

    $container = require 'config/container.php';
    $db        = $container->get(Adapter::class);

    exit((new Perintah($db, new DaftarUser($db), $bacaSandi(...), Konteks::lingkup(), $tanya))->jalankan($argumen));
} catch (Throwable $e) {
    while ($e->getPrevious() !== null) {
        $e = $e->getPrevious();
    }

    fwrite(STDERR, 'Gagal: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}
